{
  "name": "content-provenance-review-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build && npm run build:sdk",
    "build:sdk": "vite build --config review-sdk/vite.sdk.config.ts && vite build --config review-sdk/vite.harvest.config.ts",
    "build:extension": "npm run build:sdk && node extension/build.mjs",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "marked": "^14.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
