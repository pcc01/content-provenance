# ── AI Translation Provenance System — Environment Variables ──────────────────
# Copy to .env and adjust. Every value below is optional — the app runs on
# these defaults out of the box (Postgres on localhost:5432, mock translation,
# Claude scoring). Nothing here is required except a real ANTHROPIC_API_KEY if
# you set TRANSLATION_PROVIDER=anthropic or SCORING_PROVIDER=claude.

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
# ^ 8001, not 8000 — offset in case another project's stack is already using
#   8000 on this machine (see docker-compose.yml's port comment). Change
#   freely if 8000 is actually free for you.
APP_RELOAD=true
LOG_LEVEL=info
CORS_ORIGINS=*

# ── Translation Backend ─────────────────────────────────────────────────────
# mock | anthropic | deepl | google
TRANSLATION_PROVIDER=mock
ANTHROPIC_API_KEY=
DEEPL_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Quality Scoring / Redrive ───────────────────────────────────────────────
# claude | ollama | mprometheus | openai | gemini | lmstudio | vllm
#   claude/ollama/openai/gemini/lmstudio/vllm score on the shared MQM-JSON
#   rubric (app/core/scoring/mqm_prompt.py). mprometheus is a separate
#   scalar 1-5 judge on its own rubric — an addition, not a replacement.
SCORING_PROVIDER=claude
# Blank = reuse TRANSLATION_PROVIDER for redrive's retranslation step too.
REDRIVE_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_QE_MODEL=hf.co/s3nh/Unbabel-TowerInstruct-7B-v0.1-GGUF:Q4_K_M
# M-Prometheus (Unbabel) LLM-judge via Ollama GGUF. 7B fallback:
#   hf.co/mradermacher/M-Prometheus-7B-GGUF:Q5_K_M
MPROMETHEUS_MODEL=hf.co/mradermacher/M-Prometheus-14B-i1-GGUF:i1-Q4_K_M
# auto | reference_free | prefer_reference
MPROMETHEUS_REFERENCE_MODE=auto
QUALITY_THRESHOLD_DEFAULT=80
# Per-provider redrive usage budgets, JSON — see app/core/redrive/ledger.py.
# PROVIDER_USAGE_LIMITS={"deepl": {"scope": "lifetime", "limit": 500000}}
# Assert the commercial licence status of a local judge checkpoint you run,
# JSON — see app/core/scoring/licensing.py.
# SCORER_COMMERCIAL_OVERRIDES={"ollama": true}
# Optional XCOMET / word-level QE checkpoints (POST /quality/reports/{id}/attach-*).
# XCOMET_CHECKPOINT=Unbabel/XCOMET-XL
# COMETKIWI_WORDLEVEL_CHECKPOINT=Unbabel/WMT24-QE-task2-baseline

# ── Documents (Phase 7 — layout-aware review + round-trip export) ───────────
DOCUMENT_STORAGE_DIR=data/documents
# Path to the Tesseract binary for in-image OCR (blank = expect it on PATH).
# TESSERACT_CMD=

# ── Phase 13: pgGraph + Tone/Style/Voice Provenance ─────────────────────────
STYLE_SCORING_PROVIDER=claude
STYLE_THRESHOLD_DEFAULT=70
GRAPH_RETRIEVAL_ENABLED=true
GRAPH_RETRIEVAL_TOP_K=5

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# ^ 5433, not 5432 — same reasoning as APP_PORT above; matches
#   docker-compose.yml's postgres service mapping.
POSTGRES_DB=provenance
POSTGRES_USER=provenance_user
POSTGRES_PASSWORD=changeme
# Or set the whole DSN directly (overrides the POSTGRES_* pieces above):
# DATABASE_URL=postgresql://provenance_user:changeme@localhost:5433/provenance

# ── Image Assets ────────────────────────────────────────────────────────────
IMAGE_STORAGE_DIR=data/images

# ── Haystack (search) ───────────────────────────────────────────────────────
HAYSTACK_DOCUMENT_STORE=memory
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only used with the qdrant/elasticsearch docker-compose profiles:
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# ELASTICSEARCH_HOST=http://localhost:9200

# ── XLIFF ────────────────────────────────────────────────────────────────────
XLIFF_VERSION=2.0
XLIFF_TOOL_NAME=AI Translation Provenance System
XLIFF_TOOL_VERSION=1.0.0

# ── CMS Integration ──────────────────────────────────────────────────────────
# Which provider is active (see app/core/integrations/factory.py). Only
# "strapi" is implemented today — "directus"/"payload" are prepared for but
# not built yet.
CMS_PROVIDER=strapi
# Field name written on the CMS entry alongside the translated field,
# holding this system's full ProvenanceRecord.
CMS_PROVENANCE_FIELD=content_provenance
# Strapi — same per-provider naming as the translation providers above.
# Base URL of your Strapi instance and an API token with read+write access
# to whichever content type(s) you push to (Strapi admin -> Settings ->
# API Tokens). The docker-compose "cms" profile runs a local Strapi at
# http://localhost:1337 for testing — see CONTRIBUTING.md.
STRAPI_BASE_URL=
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_SECONDS=15
# Future providers (once built) will follow the same shape:
#   DIRECTUS_BASE_URL= / DIRECTUS_API_TOKEN=
#   PAYLOAD_BASE_URL=  / PAYLOAD_API_TOKEN=

# ── TMS Integration (Crowdin) ────────────────────────────────────────────────
# A TMS manages the translation/review workflow (distinct from a CMS, which
# publishes content). Only "crowdin" is implemented; phrase/lokalise/transifex
# are shaped for but not built. See app/core/tms_service.py + app/api/tms.py.
TMS_PROVIDER=crowdin
# crowdin.com: https://api.crowdin.com/api/v2
# Crowdin Enterprise: https://{organization}.api.crowdin.com/api/v2
CROWDIN_BASE_URL=https://api.crowdin.com/api/v2
# The numeric project id (Project -> Tools -> API, or the URL) and a Personal
# Access Token with "project" scope (Account Settings -> API).
CROWDIN_PROJECT_ID=
CROWDIN_API_TOKEN=
# String-based projects attach strings to a branch. Blank = the project's
# first branch (usually "main"); set a name to target/create a specific one.
CROWDIN_BRANCH=
# Random string appended as ?secret=… to the webhook callback URL and checked
# (hmac.compare_digest) on every inbound approval webhook.
CROWDIN_WEBHOOK_SECRET=
CROWDIN_TIMEOUT_SECONDS=20

# ── Security (not enforced anywhere yet — reserved for future use) ─────────
API_KEY_REQUIRED=false
API_KEY=

# ── Email Notifications (audit lead alerts) ─────────────────────────────────
# Off by default. When enabled, every POST /api/v1/audit/runs (i.e. every
# time a customer runs a site audit) emails NOTIFY_EMAIL_TO so you know to
# follow up with the lead. See app/core/notifications.py.
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFY_EMAIL_TO=admin@thewordinbits.com
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char App Password, not your
# normal password — https://myaccount.google.com/apppasswords>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Optional — if set, the alert email links straight to the audit's PDF
# report, e.g. https://audit.thewordinbits.com
PUBLIC_APP_URL=
